

# ============================================
# SUPABASE (REQUIRED)
# ============================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Admin key (NEVER expose in frontend)
# Only for secure backend operations
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ============================================
# AI MODELS — Google Gemini (RECOMMENDED)
# ============================================

# Free tier limits:
# - 15 requests/min
# - 1,500 requests/day

GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Available models:
# - gemini-2.5-flash (recommended)
# - gemini-2.5-flash-lite
# - gemini-3-pro-preview


# ============================================
# LOCAL MODEL — Ollama (DEV ONLY)
# ============================================

# If USE_LOCAL_MODEL=true, Ollama is used instead of Gemini
# Useful for development without API costs

USE_LOCAL_MODEL=false
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.2:3b


# ============================================
# RATE LIMITING (Gemini Free Tier)
# ============================================

GEMINI_RATE_LIMIT_PER_MINUTE=15
GEMINI_RATE_LIMIT_PER_DAY=1500


# ============================================
# CLOUDINARY (OPTIONAL — image uploads)
# ============================================

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ============================================
# EMAIL (OPTIONAL)
# ============================================

SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Proof Platform


# ============================================
# SLACK (OPTIONAL — alerts / logs)
# ============================================

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_MENTOR_CHANNEL=#mentors



# ============================================
# APP URL (for emails, Slack links, OAuth callbacks)
# ============================================

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================
# ENVIRONMENT
# ============================================

NODE_ENV=development


